APP_NAME=fastapi-boilerplate
# mock | live
APP_MODE=mock
LOG_LEVEL=INFO
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@localhost:${POSTGRES_PORT}/app
# SQLite로 가볍게 쓰려면: DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-me

#--- Claude LLM -----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=8192
ENABLE_PROMPT_CACHING=true

# 설계 API는 DB 없이 실행. 기존 items 테이블 초기화 시에만 true
INITIALIZE_DATABASE=false
ANTHROPIC_TIMEOUT_SECONDS=120
# 두 키가 모두 있어야 추적 활성화. EU 기본값; US/자체 호스팅은 URL 변경
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
